# Copy this file to ".env" and fill in your own values. Never commit the real ".env" file.

# MongoDB connection string (local mongod, or a free MongoDB Atlas cluster)
MONGO_URI=mongodb://localhost:27017/jobportal

# Port the backend server listens on. Must match VITE_API_BASE_URL's port on the frontend.
PORT=8000

# Any long random string, used to sign login tokens (JWT). Keep this secret.
SECRET_KEY=change_this_to_a_long_random_string

# The frontend's URL, so the backend allows it through CORS.
# Locally this can be left out (localhost is already allowed by default).
# When deployed, set this to your real frontend URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Cloudinary account (free tier is fine) - used to store uploaded resumes/photos/logos
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Optional: only needed for the "forgot password" email + application status emails.
# If left blank, the app still works - it just logs a warning instead of sending an email
# (and prints the password reset link to the server console so you can still test it).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional - only needed to auto-create embeddable video call rooms for interviews (via Daily.co).
# If left blank, recruiters can still paste in any meeting link (Zoom/Meet/etc) manually.
# Get a free key at: https://dashboard.daily.co/developers
DAILY_API_KEY=

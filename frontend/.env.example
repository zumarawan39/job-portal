# Copy this file to ".env" and fill in your own values (only needed when deploying,
# or if your backend runs on a different port locally).

# The backend API's base URL. Locally this can be left out entirely -
# it defaults to http://localhost:8000. When deployed, set it to your real
# backend URL, e.g. https://your-app.onrender.com
VITE_API_BASE_URL=http://localhost:8000
